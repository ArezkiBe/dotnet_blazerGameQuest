{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "gameapi-cluster": {
        "Destinations": {
          "gameapi": {
            "Address": "http://gameapi:5001/"
          }
        }
      },
      "blazor-cluster": {
        "Destinations": {
          "blazor": {
            "Address": "http://blazor-client:80/"
          }
        }
      }
    }
  }
}
