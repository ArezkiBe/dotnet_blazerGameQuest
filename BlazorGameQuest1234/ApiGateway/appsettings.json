{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "gameapi-route": {
        "ClusterId": "gameapi-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeadersCopy": true
          }
        ],
        "Order": 1
      },
      "swagger-route": {
        "ClusterId": "gameapi-cluster",
        "Match": {
          "Path": "/swagger/{**catch-all}"
        },
        "Order": 2
      },
      "openapi-route": {
        "ClusterId": "gameapi-cluster",
        "Match": {
          "Path": "/openapi/{**catch-all}"
        },
        "Order": 3
      },
      "blazor-route": {
        "ClusterId": "blazor-cluster",
        "Match": {
          "Path": "/{**catch-all}"
        },
        "Order": 1000
      }
    },
    "Clusters": {
      "gameapi-cluster": {
        "Destinations": {
          "gameapi": {
            "Address": "http://gameapi:5001/"
          }
        }
      },
      "blazor-cluster": {
        "Destinations": {
          "blazor": {
            "Address": "http://blazor-client:80/"
          }
        }
      }
    }
  }
}
