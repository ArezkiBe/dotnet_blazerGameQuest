@*
    Page de préparation d'aventure
    Permet au joueur de démarrer une nouvelle aventure dans le donjon
*@
@page "/adventure"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationService AuthService
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        @{
            var isPlayer = AuthService.IsPlayer(context.User);
        }
        @if (!isPlayer)
        {
            <div class="access-denied">
                <h2>🚫 Accès Refusé</h2>
                <p>Cette page est réservée aux joueurs. Les administrateurs n'ont pas accès aux aventures.</p>
                <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/")'>
                    Retour à l'accueil
                </button>
            </div>
        }
        else
        {
            <div class="adventure-container">
                <h1>⚔️ Nouvelle Aventure ⚔️</h1>
                
                <div class="adventure-setup">
                    <div class="player-info">
                        <h3>🛡️ Informations du Joueur</h3>
                        <p><strong>👤 Nom :</strong> @context.User.FindFirst("preferred_username")?.Value</p>
                        <p><strong>💰 Statut :</strong> Connecté</p>
                    </div>
                    
                    <div class="game-start">
                        <h3>⚡ Prêt à commencer ?</h3>
                        <p>Une nouvelle aventure vous attend dans les profondeurs du donjon...</p>
                        
                        <button class="medieval-btn-primary" @onclick="StartAdventure">
                            🗡️ Commencer l'Aventure 🗡️
                        </button>
                    </div>
                    
                    @if (adventureStarted)
                    {
                        <div class="adventure-started">
                            <div class="medieval-alert-success">
                                <h4>🏰 Aventure Démarrée !</h4>
                                <p>🌙 Vous entrez dans le donjon... Les ombres dansent sur les murs humides. 🌙</p>
                                <a href="game" class="medieval-btn-secondary">🚪 Entrer dans la première salle 🚪</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="access-denied">
            <h2>🔐 Connexion Requise</h2>
            <p>Vous devez être connecté pour accéder aux aventures.</p>
            <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/login")'>
                Se connecter
            </button>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    /// <summary>
    /// Indique si l'aventure a été démarrée par l'utilisateur
    /// </summary>
    private bool adventureStarted = false;
    
    /// <summary>
    /// Démarre une nouvelle aventure et affiche le message de confirmation
    /// Appelée lorsque l'utilisateur clique sur "Commencer l'Aventure"
    /// </summary>
    private void StartAdventure()
    {
        adventureStarted = true;
    }
}

<style>
/* Adventure Page Styles - Médiéval/Pixelart */
.adventure-container { 
    max-width: 700px; 
    margin: 0 auto; 
    padding: 2rem;
    font-family: 'Courier New', monospace;
    color: #ffd700;
}

/* Titre principal */
.adventure-container h1 {
    color: #ffd700 !important;
    text-align: center;
    font-family: 'Courier New', monospace;
    font-size: 2.2rem;
    text-shadow: none;
    margin-bottom: 2rem;
    background: linear-gradient(90deg, #8b4513, #654321);
    padding: 1.5rem;
    border: 4px solid #d4af37;
    border-radius: 0;
    box-shadow: 
        inset 2px 2px 0px rgba(212, 175, 55, 0.3),
        inset -2px -2px 0px rgba(0, 0, 0, 0.8),
        4px 4px 0px #000;
}

.adventure-setup { 
    background: linear-gradient(135deg, #2d1b0e 0%, #1a1008 50%, #0f0804 100%);
    padding: 2rem; 
    border-radius: 0;
    margin-top: 1rem;
    border: 3px solid #8b4513;
    border-top: 3px solid #d4af37;
    box-shadow: 
        inset 2px 2px 0px rgba(212, 175, 55, 0.2),
        inset -2px -2px 0px rgba(0, 0, 0, 0.8),
        4px 4px 8px rgba(0, 0, 0, 0.6);
}

.player-info, .game-start { 
    margin-bottom: 2rem; 
    padding: 1.5rem; 
    background: linear-gradient(90deg, #3c2414, #2d1b0e);
    border-radius: 0;
    border: 2px solid #654321;
    border-left: 6px solid #d4af37;
    box-shadow: 
        inset 1px 1px 0px rgba(212, 175, 55, 0.2),
        2px 2px 0px #000;
}

/* Titres des sections */
.player-info h3, .game-start h3 {
    color: #d4af37 !important;
    font-family: 'Courier New', monospace;
    text-shadow: none;
    border-bottom: 2px dashed #654321;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Texte et paragraphes */
.player-info p, .game-start p {
    color: #ffd700 !important;
    font-family: 'Courier New', monospace;
    line-height: 1.6;
    text-shadow: none;
    margin-bottom: 0.8rem;
}

/* Texte en gras */
.player-info strong, .game-start strong {
    color: #fff !important;
    text-shadow: none;
}

/* Boutons */
.player-info .btn, .game-start .btn {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 0;
    padding: 1rem 2rem;
    font-size: 1.1rem;
    transition: all 0.2s ease;
}

.btn-success {
    background: linear-gradient(90deg, #16a34a, #15803d) !important;
    color: #fff !important;
    border: 3px solid #22c55e !important;
    text-shadow: none !important;
    box-shadow: 
        inset 2px 2px 0px rgba(34, 197, 94, 0.3),
        4px 4px 0px #000,
        0 0 15px rgba(22, 163, 74, 0.4);
}

.btn-success:hover {
    background: linear-gradient(90deg, #22c55e, #16a34a) !important;
    transform: translateY(-2px);
    box-shadow: 
        inset 2px 2px 0px rgba(34, 197, 94, 0.4),
        6px 6px 0px #000,
        0 0 20px rgba(22, 163, 74, 0.6);
}

.btn-primary {
    background: linear-gradient(90deg, #d4af37, #b8941f) !important;
    color: #000 !important;
    border: 3px solid #ffd700 !important;
    text-shadow: none !important;
    box-shadow: 
        inset 2px 2px 0px rgba(255, 255, 255, 0.3),
        4px 4px 0px #000,
        0 0 15px rgba(212, 175, 55, 0.4);
}

.btn-primary:hover {
    background: linear-gradient(90deg, #ffd700, #d4af37) !important;
    transform: translateY(-2px);
    box-shadow: 
        inset 2px 2px 0px rgba(255, 255, 255, 0.4),
        6px 6px 0px #000,
        0 0 20px rgba(212, 175, 55, 0.6);
}

/* Section aventure commencée */
.adventure-started { 
    margin-top: 2rem; 
}

.adventure-started .alert {
    background: linear-gradient(135deg, #1a1008, #0f0804) !important;
    border: 3px solid #d4af37 !important;
    border-radius: 0 !important;
    padding: 2rem !important;
    box-shadow: 
        inset 2px 2px 0px rgba(212, 175, 55, 0.2),
        4px 4px 8px rgba(0, 0, 0, 0.6);
}

.adventure-started h4 {
    color: #d4af37 !important;
    font-family: 'Courier New', monospace;
    text-shadow: none;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.adventure-started p {
    color: #ffd700 !important;
    font-family: 'Courier New', monospace;
    text-shadow: none;
    font-style: italic;
    font-size: 1.1rem;
}

/* Medieval Alert for adventure started notification */
.medieval-alert-success {
    background: linear-gradient(90deg, #15803d, #166534) !important;
    color: #ffd700 !important;
    border: 2px solid #d4af37;
    box-shadow: 
        inset 1px 1px 0px rgba(212, 175, 55, 0.2),
        3px 3px 0px #000;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    text-shadow: none;
    padding: 1rem;
    margin: 0.5rem 0;
    border-radius: 0;
}

/* Medieval primary button for main actions */
.medieval-btn-primary { 
    padding: 1.2rem 2.5rem; 
    font-size: 1.3rem;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 0;
    background: linear-gradient(90deg, #d4af37, #b8941f) !important;
    color: #000 !important;
    border: 3px solid #ffd700 !important;
    text-shadow: none !important;
    box-shadow: 
        inset 2px 2px 0px rgba(255, 255, 255, 0.3),
        4px 4px 0px #000,
        0 0 20px rgba(212, 175, 55, 0.4);
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-block;
}

.medieval-btn-primary:hover {
    background: linear-gradient(90deg, #ffd700, #d4af37) !important;
    color: #000 !important;
    transform: translateY(-2px);
    box-shadow: 
        inset 2px 2px 0px rgba(255, 255, 255, 0.4),
        6px 6px 0px #000,
        0 0 25px rgba(212, 175, 55, 0.6);
    text-decoration: none;
}

.medieval-btn-primary:active {
    transform: translateY(0px);
    box-shadow: 
        inset 2px 2px 0px rgba(0, 0, 0, 0.2),
        2px 2px 0px #000;
}
</style>