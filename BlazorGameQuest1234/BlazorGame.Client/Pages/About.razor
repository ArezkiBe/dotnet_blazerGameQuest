@*
    Page à propos du projet BlazorGameQuest
    Contient les informations techniques, fonctionnalités et crédits
*@
@page "/about"

<div class="about-container">
    <h1>📜 À Propos de BlazorGameQuest 📜</h1>
    
    <div class="project-info">
        <div class="info-section">
            <h2>🏰 Description du Projet</h2>
            <p>
                <strong>BlazorGameQuest</strong> est un jeu d'aventure RPG complet développé avec 
                <strong>Blazor WebAssembly</strong> et <strong>.NET 9</strong>. 
                Les joueurs créent des personnages, explorent des donjons générés dynamiquement, 
                combattent des monstres, montent en niveau et accumulent des scores élevés 
                dans cette expérience RPG immersive.
            </p>
        </div>

        <div class="info-section">
            <h2>🎯 Objectifs du Jeu</h2>
            <ul>
                <li>⚔️ Créer et gérer votre personnage avec HP, XP et niveau</li>
                <li>🏰 Explorer des donjons de 5 salles générés dynamiquement</li>
                <li>🗡️ Faire des choix tactiques (Combat, Fuite, Investigation, Fouille)</li>
                <li>🏆 Accumuler des points selon vos actions et la difficulté</li>
                <li>❤️ Gérer votre santé et éviter la mort</li>
                <li>✨ Monter de niveau pour améliorer vos statistiques</li>
                <li>💎 Découvrir des trésors et objets rares</li>
                <li>📊 Maîtriser le système de risques vs récompenses</li>
            </ul>
        </div>

        <div class="info-section">
            <h2>🏗️ Architecture Technique</h2>
            <div class="tech-grid">
                <div class="tech-item">
                    <h4>⚡ Frontend</h4>
                    <ul>
                        <li>Blazor WebAssembly .NET 9</li>
                        <li>Interface thème médiéval</li>
                        <li>Système UI cohérent</li>
                        <li>Navigation responsive</li>
                    </ul>
                </div>
                <div class="tech-item">
                    <h4>⚙️ Backend</h4>
                    <ul>
                        <li>API .NET 9 avec EF Core</li>
                        <li>Services de génération de donjons</li>
                        <li>Gestion des sessions de jeu</li>
                        <li>Microservices d'authentification</li>
                    </ul>
                </div>
                <div class="tech-item">
                    <h4>💾 Données</h4>
                    <ul>
                        <li>Entity Framework Core</li>
                        <li>Base de données en mémoire</li>
                        <li>Modèles partagés</li>
                        <li>Migration automatique</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="info-section">
            <h2>✅ Fonctionnalités Actuelles - Version 3.0</h2>
            <div class="features-current">
                <div class="feature-item completed">
                    <span class="status">✅</span>
                    <span>Interface complète avec thème médiéval</span>
                </div>
                <div class="feature-item completed">
                    <span class="status">✅</span>
                    <span>Génération dynamique de donjons (5 types de salles)</span>
                </div>
                <div class="feature-item completed">
                    <span class="status">✅</span>
                    <span>Système complet de santé (HP) et de progression (XP)</span>
                </div>
                <div class="feature-item completed">
                    <span class="status">✅</span>
                    <span>5 types d'actions : Combat, Fuite, Investigation, Fouille, Ignorer</span>
                </div>
                <div class="feature-item completed">
                    <span class="status">✅</span>
                    <span>Système de niveaux avec amélioration des statistiques</span>
                </div>
                <div class="feature-item completed">
                    <span class="status">✅</span>
                    <span>3 niveaux de difficulté avec multiplicateurs de score</span>
                </div>
                <div class="feature-item completed">
                    <span class="status">✅</span>
                    <span>Découverte d'objets et trésors</span>
                </div>
                <div class="feature-item completed">
                    <span class="status">✅</span>
                    <span>API Backend avec Entity Framework Core</span>
                </div>
                <div class="feature-item completed">
                    <span class="status">✅</span>
                    <span>Gestion des joueurs et sessions de jeu</span>
                </div>
                <div class="feature-item completed">
                    <span class="status">✅</span>
                    <span>Tests unitaires et d'intégration complets</span>
                </div>
            </div>
        </div>

        <div class="info-section">
            <h2>🚀 Fonctionnalités Prévues - Versions 4.0 & 5.0</h2>
            <div class="features-planned">
                <div class="feature-item planned">
                    <span class="status">📋</span>
                    <span>Authentification et autorisation utilisateurs</span>
                </div>
                <div class="feature-item planned">
                    <span class="status">📋</span>
                    <span>Base de données persistante (remplacement InMemory)</span>
                </div>
                <div class="feature-item planned">
                    <span class="status">📋</span>
                    <span>Tableau de bord administrateur</span>
                </div>
                <div class="feature-item planned">
                    <span class="status">📋</span>
                    <span>Classements globaux et historique complet</span>
                </div>
                <div class="feature-item planned">
                    <span class="status">📋</span>
                    <span>Système d'équipement et inventaire</span>
                </div>
                <div class="feature-item planned">
                    <span class="status">📋</span>
                    <span>Multijoueur et guildes</span>
                </div>
            </div>
        </div>

        <div class="info-section">
            <h2>🎓 Développement</h2>
            <p>
                <strong>Projet académique</strong> - EFREI LSI3 S7<br/>
                <strong>Matière :</strong> .NET Development<br/>
                <strong>Période :</strong> Octobre - Novembre 2025<br/>
                <strong>Version actuelle :</strong> 3.0 (Jeu Complet avec API)<br/>
                <strong>Statut :</strong> Fonctionnel et jouable
            </p>
        </div>
    </div>
    
    <div class="back-actions">
        <a href="/" class="medieval-btn-secondary">🏠 Retour à l'Accueil</a>
        <a href="/adventure" class="medieval-btn-primary">🗡️ Commencer à Jouer</a>
    </div>
</div>

<style>
/* About Page Styles - Médiéval/Pixelart */
.about-container { 
    max-width: 1100px; 
    margin: 0 auto; 
    padding: 2rem;
    font-family: 'Courier New', monospace;
    color: #ffd700;
}

/* Titre principal */
.about-container h1 {
    color: #ffd700 !important;
    text-align: center;
    font-family: 'Courier New', monospace;
    font-size: 2.2rem;
    text-shadow: none;
    margin-bottom: 2rem;
    background: linear-gradient(90deg, #8b4513, #654321);
    padding: 1.5rem;
    border: 4px solid #d4af37;
    border-radius: 0;
    box-shadow: 
        inset 2px 2px 0px rgba(212, 175, 55, 0.3),
        inset -2px -2px 0px rgba(0, 0, 0, 0.8),
        4px 4px 0px #000;
}

.project-info { 
    margin: 2rem 0; 
}

/* Sections d'informations */
.info-section { 
    background: linear-gradient(135deg, #2d1b0e 0%, #1a1008 50%, #0f0804 100%);
    margin-bottom: 2rem; 
    padding: 2rem; 
    border-radius: 0;
    border: 3px solid #8b4513;
    border-left: 6px solid #d4af37;
    box-shadow: 
        inset 2px 2px 0px rgba(212, 175, 55, 0.2),
        inset -2px -2px 0px rgba(0, 0, 0, 0.8),
        4px 4px 8px rgba(0, 0, 0, 0.6);
}

.info-section h2 { 
    color: #d4af37 !important;
    margin-bottom: 1.5rem;
    font-family: 'Courier New', monospace;
    text-shadow: none;
    border-bottom: 3px dashed #654321;
    padding-bottom: 0.7rem;
    font-size: 1.6rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Textes et paragraphes */
.info-section p {
    color: #ffd700 !important;
    font-family: 'Courier New', monospace;
    line-height: 1.6;
    text-shadow: none;
    margin-bottom: 1rem;
}

.info-section strong {
    color: #fff !important;
    text-shadow: none;
}

.info-section ul {
    color: #ffd700 !important;
    font-family: 'Courier New', monospace;
    text-shadow: none;
}

.info-section li {
    margin-bottom: 0.5rem;
    color: #ffd700 !important;
}

/* Grille technique */
.tech-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); 
    gap: 1.5rem; 
    margin-top: 1.5rem; 
}

.tech-item { 
    background: linear-gradient(90deg, #3c2414, #2d1b0e);
    padding: 1.5rem; 
    border-radius: 0;
    border: 2px solid #654321;
    border-left: 5px solid #22c55e;
    box-shadow: 
        inset 1px 1px 0px rgba(34, 197, 94, 0.2),
        2px 2px 0px #000;
}

.tech-item h4 { 
    margin-bottom: 1rem; 
    color: #22c55e !important;
    font-family: 'Courier New', monospace;
    text-shadow: none;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-bottom: 2px solid #22c55e;
    padding-bottom: 0.5rem;
}

.tech-item ul {
    padding-left: 1.5rem;
}

.tech-item li {
    color: #ffd700 !important;
    font-family: 'Courier New', monospace;
    text-shadow: none;
    margin-bottom: 0.3rem;
}

/* Grilles de fonctionnalités */
.features-current, .features-planned { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); 
    gap: 1rem; 
    margin-top: 1.5rem; 
}

.feature-item { 
    background: linear-gradient(90deg, #3c2414, #2d1b0e);
    padding: 1rem; 
    border-radius: 0;
    display: flex; 
    align-items: center; 
    gap: 1rem;
    font-family: 'Courier New', monospace;
    color: #ffd700 !important;
    text-shadow: none;
    border: 2px solid #654321;
    box-shadow: 
        inset 1px 1px 0px rgba(212, 175, 55, 0.1),
        2px 2px 0px #000;
}

.feature-item.completed { 
    border-left: 5px solid #22c55e;
    box-shadow: 
        inset 1px 1px 0px rgba(34, 197, 94, 0.2),
        2px 2px 0px #000,
        0 0 10px rgba(34, 197, 94, 0.3);
}

.feature-item.planned { 
    border-left: 5px solid #f59e0b;
    box-shadow: 
        inset 1px 1px 0px rgba(245, 158, 11, 0.2),
        2px 2px 0px #000,
        0 0 10px rgba(245, 158, 11, 0.3);
}

.status { 
    font-weight: bold; 
    min-width: 30px;
    font-size: 1.2rem;
    filter: drop-shadow(1px 1px 0px #000);
}

/* Actions de retour */
.back-actions { 
    text-align: center; 
    margin-top: 3rem; 
    padding-top: 2rem; 
    border-top: 4px dashed #8b4513;
    background: linear-gradient(90deg, rgba(139, 69, 19, 0.1), rgba(45, 27, 14, 0.1));
    padding: 2rem;
    border: 3px solid #8b4513;
    border-radius: 0;
    box-shadow: 
        inset 2px 2px 0px rgba(212, 175, 55, 0.1),
        2px 2px 0px #000;
}

.back-actions .btn { 
    margin: 0 1rem; 
    padding: 1rem 2rem;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 0;
    transition: all 0.2s ease;
    text-shadow: none;
}

.medieval-btn-primary { 
    padding: 1.2rem 2.5rem; 
    font-size: 1.3rem;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 0;
    background: linear-gradient(90deg, #d4af37, #b8941f) !important;
    color: #000 !important;
    border: 3px solid #ffd700 !important;
    text-shadow: none !important;
    box-shadow: 
        inset 2px 2px 0px rgba(255, 255, 255, 0.3),
        4px 4px 0px #000,
        0 0 20px rgba(212, 175, 55, 0.4);
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-block;
    margin: 0.5rem;
}

.medieval-btn-primary:hover {
    background: linear-gradient(90deg, #ffd700, #d4af37) !important;
    color: #000 !important;
    transform: translateY(-2px);
    box-shadow: 
        inset 2px 2px 0px rgba(255, 255, 255, 0.4),
        6px 6px 0px #000,
        0 0 25px rgba(212, 175, 55, 0.6);
    text-decoration: none;
}

.medieval-btn-secondary {
    background: linear-gradient(90px, #64748b, #475569) !important;
    color: #ffd700 !important;
    border: 2px solid #8b4513;
    box-shadow: 
        inset 1px 1px 0px rgba(212, 175, 55, 0.2),
        3px 3px 0px #000;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    text-shadow: none;
    padding: 1.2rem 2.5rem;
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 0;
    text-decoration: none;
    display: inline-block;
    margin: 0.5rem;
    transition: all 0.2s ease;
}

.medieval-btn-secondary:hover {
    background: linear-gradient(90deg, #94a3b8, #64748b) !important;
    color: #fff !important;
    transform: translateY(-2px);
    box-shadow: 
        inset 2px 2px 0px rgba(148, 163, 184, 0.4),
        6px 6px 0px #000;
    text-decoration: none;
}

/* Animation pour les features */
.feature-item:hover {
    transform: translateX(3px);
    transition: transform 0.2s ease;
}
</style>