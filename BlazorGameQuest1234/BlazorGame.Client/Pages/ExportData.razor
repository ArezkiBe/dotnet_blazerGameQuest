@page "/admin/export"
@using SharedModels.Models
@using System.Text.Json
@using System.Text
@inject UserContextService UserContext
@inject IGameApiService GameApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Export des Données - BlazorGameQuest Admin</PageTitle>

@if (!UserContext.IsAdmin)
{
    <div class="access-denied">
        <h2>🚫 Accès Refusé</h2>
        <p>Vous devez être administrateur pour accéder à cette page.</p>
        <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/")'>
            Retour à l'accueil
        </button>
    </div>
}
else
{
    <div class="export-page">
        <div class="page-header">
            <h1>📊 Export des Données</h1>
            <button class="back-btn" @onclick='() => Navigation.NavigateTo("/admin")'>
                ← Retour au Dashboard
            </button>
        </div>

        <div class="export-options">
            <!-- Players Export -->
            <div class="export-card">
                <div class="export-header">
                    <div class="export-icon">👥</div>
                    <h3>Données des Joueurs</h3>
                </div>
                <p>Exporter la liste complète des joueurs avec leurs informations de base et statistiques.</p>
                
                <div class="export-format">
                    <label>Format:</label>
                    <select @bind="playersFormat">
                        <option value="json">JSON</option>
                        <option value="csv">CSV</option>
                    </select>
                </div>
                
                <div class="export-options-list">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeInactivePlayers" />
                        Inclure les joueurs inactifs
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeEmails" />
                        Inclure les emails
                    </label>
                </div>

                <button class="export-btn" @onclick="ExportPlayers" disabled="@isExporting">
                    @if (isExporting)
                    {
                        <text>⏳ Export en cours...</text>
                    }
                    else
                    {
                        <text>📥 Télécharger les Joueurs</text>
                    }
                </button>
            </div>

            <!-- Leaderboard Export -->
            <div class="export-card">
                <div class="export-header">
                    <div class="export-icon">🏆</div>
                    <h3>Classement</h3>
                </div>
                <p>Exporter le classement des joueurs trié par score avec les rangs.</p>
                
                <div class="export-format">
                    <label>Format:</label>
                    <select @bind="leaderboardFormat">
                        <option value="json">JSON</option>
                        <option value="csv">CSV</option>
                    </select>
                </div>
                
                <div class="export-options-list">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="topPlayersOnly" />
                        Top 20 seulement
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeGameSessions" />
                        Inclure le nombre de parties
                    </label>
                </div>

                <button class="export-btn" @onclick="ExportLeaderboard" disabled="@isExporting">
                    @if (isExporting)
                    {
                        <text>⏳ Export en cours...</text>
                    }
                    else
                    {
                        <text>📥 Télécharger le Classement</text>
                    }
                </button>
            </div>

            <!-- Statistics Export -->
            <div class="export-card">
                <div class="export-header">
                    <div class="export-icon">📈</div>
                    <h3>Statistiques Globales</h3>
                </div>
                <p>Exporter un résumé des statistiques globales de l'application.</p>
                
                <div class="export-format">
                    <label>Format:</label>
                    <select @bind="statsFormat">
                        <option value="json">JSON</option>
                        <option value="csv">CSV</option>
                    </select>
                </div>

                <button class="export-btn" @onclick="ExportStatistics" disabled="@isExporting">
                    @if (isExporting)
                    {
                        <text>⏳ Export en cours...</text>
                    }
                    else
                    {
                        <text>📥 Télécharger les Statistiques</text>
                    }
                </button>
            </div>
        </div>

        <!-- Export History -->
        @if (exportHistory.Any())
        {
            <div class="export-history">
                <h2>📋 Historique des Exports</h2>
                <div class="history-list">
                    @foreach (var export in exportHistory.Take(10))
                    {
                        <div class="history-item">
                            <div class="history-info">
                                <strong>@export.Type</strong>
                                <span class="history-format">@export.Format.ToUpper()</span>
                            </div>
                            <div class="history-date">@export.Date.ToString("dd/MM/yyyy à HH:mm")</div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="status-message @(isError ? "error" : "success")">
                @statusMessage
            </div>
        }
    </div>
}

@code {
    private bool isExporting = false;
    private string statusMessage = "";
    private bool isError = false;

    // Export format options
    private string playersFormat = "json";
    private string leaderboardFormat = "json";
    private string statsFormat = "json";

    // Export options
    private bool includeInactivePlayers = false;
    private bool includeEmails = true;
    private bool topPlayersOnly = false;
    private bool includeGameSessions = true;

    // Export history
    private List<ExportRecord> exportHistory = new();

    public class ExportRecord
    {
        public string Type { get; set; } = "";
        public string Format { get; set; } = "";
        public DateTime Date { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!UserContext.IsAdmin)
        {
            Navigation.NavigateTo("/");
            return;
        }
    }

    private async Task ExportPlayers()
    {
        try
        {
            isExporting = true;
            statusMessage = "";
            StateHasChanged();

            var players = await GameApi.GetPlayersAsync();
            var users = await GameApi.GetUsersAsync();

            // Filter players based on options
            var playerData = players.Select(p => new
            {
                p.Id,
                p.Username,
                Email = includeEmails ? users.FirstOrDefault(u => u.Id == p.UserId)?.Email : "***",
                p.Score,
                p.CurrentRoom,
                CreatedAt = p.CreatedAt.ToString("yyyy-MM-dd"),
                IsActive = users.FirstOrDefault(u => u.Id == p.UserId)?.IsActive ?? false
            });

            if (!includeInactivePlayers)
            {
                playerData = playerData.Where(p => p.IsActive);
            }

            var data = playerData.ToList();
            var filename = $"players_{DateTime.Now:yyyyMMdd_HHmmss}";

            if (playersFormat == "json")
            {
                await DownloadJsonFile(data, $"{filename}.json");
            }
            else
            {
                await DownloadCsvFile(data, $"{filename}.csv");
            }

            exportHistory.Insert(0, new ExportRecord
            {
                Type = "Joueurs",
                Format = playersFormat,
                Date = DateTime.Now
            });

            statusMessage = $"Export des joueurs réussi! {data.Count} entrées exportées.";
            isError = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Erreur lors de l'export: {ex.Message}";
            isError = true;
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private async Task ExportLeaderboard()
    {
        try
        {
            isExporting = true;
            statusMessage = "";
            StateHasChanged();

            var players = await GameApi.GetPlayersAsync();
            var users = await GameApi.GetUsersAsync();

            var leaderboardData = players
                .OrderByDescending(p => p.Score)
                .Select((p, index) => new
                {
                    Rank = index + 1,
                    p.Username,
                    p.Score,
                    GameSessions = includeGameSessions ? (p.GameSessions?.Count ?? 0) : 0,
                    IsActive = users.FirstOrDefault(u => u.Id == p.UserId)?.IsActive ?? false
                });

            if (topPlayersOnly)
            {
                leaderboardData = leaderboardData.Take(20);
            }

            var data = leaderboardData.ToList();
            var filename = $"leaderboard_{DateTime.Now:yyyyMMdd_HHmmss}";

            if (leaderboardFormat == "json")
            {
                await DownloadJsonFile(data, $"{filename}.json");
            }
            else
            {
                await DownloadCsvFile(data, $"{filename}.csv");
            }

            exportHistory.Insert(0, new ExportRecord
            {
                Type = "Classement",
                Format = leaderboardFormat,
                Date = DateTime.Now
            });

            statusMessage = $"Export du classement réussi! {data.Count} entrées exportées.";
            isError = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Erreur lors de l'export: {ex.Message}";
            isError = true;
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private async Task ExportStatistics()
    {
        try
        {
            isExporting = true;
            statusMessage = "";
            StateHasChanged();

            var players = await GameApi.GetPlayersAsync();
            var users = await GameApi.GetUsersAsync();

            var stats = new
            {
                ExportDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
                TotalPlayers = players.Count,
                ActivePlayers = users.Count(u => u.IsActive && u.Role == UserRole.Player),
                InactivePlayers = users.Count(u => !u.IsActive && u.Role == UserRole.Player),
                TotalScore = players.Sum(p => p.Score),
                AverageScore = players.Any() ? (int)players.Average(p => p.Score) : 0,
                TopScore = players.Any() ? players.Max(p => p.Score) : 0,
                TopPlayer = players.OrderByDescending(p => p.Score).FirstOrDefault()?.Username ?? "N/A",
                TotalGameSessions = players.Sum(p => p.GameSessions?.Count ?? 0)
            };

            var filename = $"statistics_{DateTime.Now:yyyyMMdd_HHmmss}";

            if (statsFormat == "json")
            {
                await DownloadJsonFile(stats, $"{filename}.json");
            }
            else
            {
                // For CSV, convert to a list of key-value pairs
                var csvData = new[]
                {
                    new { Metric = "Date d'export", Value = stats.ExportDate },
                    new { Metric = "Joueurs total", Value = stats.TotalPlayers.ToString() },
                    new { Metric = "Joueurs actifs", Value = stats.ActivePlayers.ToString() },
                    new { Metric = "Joueurs inactifs", Value = stats.InactivePlayers.ToString() },
                    new { Metric = "Score total", Value = stats.TotalScore.ToString() },
                    new { Metric = "Score moyen", Value = stats.AverageScore.ToString() },
                    new { Metric = "Meilleur score", Value = stats.TopScore.ToString() },
                    new { Metric = "Meilleur joueur", Value = stats.TopPlayer },
                    new { Metric = "Parties totales", Value = stats.TotalGameSessions.ToString() }
                };

                await DownloadCsvFile(csvData, $"{filename}.csv");
            }

            exportHistory.Insert(0, new ExportRecord
            {
                Type = "Statistiques",
                Format = statsFormat,
                Date = DateTime.Now
            });

            statusMessage = "Export des statistiques réussi!";
            isError = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Erreur lors de l'export: {ex.Message}";
            isError = true;
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private async Task DownloadJsonFile(object data, string filename)
    {
        var json = JsonSerializer.Serialize(data, new JsonSerializerOptions { WriteIndented = true });
        var bytes = Encoding.UTF8.GetBytes(json);
        await JSRuntime.InvokeVoidAsync("downloadFile", filename, "application/json", bytes);
    }

    private async Task DownloadCsvFile(object data, string filename)
    {
        var csv = ConvertToCsv(data);
        var bytes = Encoding.UTF8.GetBytes(csv);
        await JSRuntime.InvokeVoidAsync("downloadFile", filename, "text/csv", bytes);
    }

    private string ConvertToCsv(object data)
    {
        var sb = new StringBuilder();
        
        if (data is IEnumerable<object> list && list.Any())
        {
            var first = list.First();
            var properties = first.GetType().GetProperties();
            
            // Header
            sb.AppendLine(string.Join(",", properties.Select(p => p.Name)));
            
            // Data
            foreach (var item in list)
            {
                var values = properties.Select(p => 
                {
                    var value = p.GetValue(item)?.ToString() ?? "";
                    // Escape quotes and wrap in quotes if contains comma
                    if (value.Contains(",") || value.Contains("\""))
                    {
                        value = "\"" + value.Replace("\"", "\"\"") + "\"";
                    }
                    return value;
                });
                sb.AppendLine(string.Join(",", values));
            }
        }
        
        return sb.ToString();
    }
}