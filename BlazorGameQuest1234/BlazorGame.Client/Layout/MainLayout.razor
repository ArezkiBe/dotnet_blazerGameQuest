@*
    Layout principal de l'application BlazorGameQuest
    Structure de base avec navigation latérale et contenu principal
*@
@inherits LayoutComponentBase

<div class="game-layout">
    <NavMenu />
    
    <main class="main-content">
        <article class="content-container">
            @Body
        </article>
    </main>
</div>

<style>
/* Game Layout Structure */
.game-layout {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
}

.main-content {
    flex: 1;
    margin-left: 280px;
    margin-top: 0;
    background: transparent;
    min-height: 100vh;
}

.content-container {
    padding: 2rem;
    max-width: 1200px;
    margin: 0 auto;
}
</style>
