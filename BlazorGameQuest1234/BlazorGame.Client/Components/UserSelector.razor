@using SharedModels.Models
@inject UserContextService UserContext
@inject IGameApiService GameApi

<div class="user-selector">
    <h5 class="selector-title">👤 Sélectionner un utilisateur</h5>
    
    @if (users.Any())
    {
        <div class="user-list">
            @foreach (var user in users)
            {
                <button class="user-btn @(IsCurrentUser(user) ? "active" : "")" 
                        @onclick="() => SelectUser(user)">
                    <span class="user-icon">
                        @if (user.Role == UserRole.Administrator)
                        {
                            <text>👑</text>
                        }
                        else
                        {
                            <text>🎮</text>
                        }
                    </span>
                    <div class="user-info">
                        <div class="user-name">@user.Username</div>
                        <div class="user-role">@(user.Role == UserRole.Administrator ? "Admin" : "Joueur")</div>
                    </div>
                </button>
            }
        </div>
        
        @if (UserContext.IsLoggedIn)
        {
            <button class="logout-btn" @onclick="Logout">
                🚪 Déconnexion
            </button>
        }
    }
    else if (isLoading)
    {
        <div class="loading">⏳ Chargement des utilisateurs...</div>
    }
    else
    {
        <div class="error">❌ Impossible de charger les utilisateurs</div>
        <button class="retry-btn" @onclick="LoadUsers">🔄 Réessayer</button>
    }
</div>

<style>
    .user-selector {
        background: var(--bs-dark);
        border: 2px solid var(--bs-warning);
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .selector-title {
        color: var(--bs-warning);
        text-align: center;
        margin-bottom: 1rem;
        font-weight: bold;
    }

    .user-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .user-btn {
        display: flex;
        align-items: center;
        background: var(--bs-secondary);
        border: 2px solid transparent;
        border-radius: 6px;
        padding: 0.75rem;
        color: white;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
    }

    .user-btn:hover {
        background: var(--bs-info);
        border-color: var(--bs-warning);
    }

    .user-btn.active {
        background: var(--bs-success);
        border-color: var(--bs-warning);
        box-shadow: 0 0 10px rgba(255, 193, 7, 0.5);
    }

    .user-icon {
        font-size: 1.2rem;
        margin-right: 0.75rem;
    }

    .user-info {
        flex: 1;
        text-align: left;
    }

    .user-name {
        font-weight: bold;
        font-size: 0.9rem;
    }

    .user-role {
        font-size: 0.8rem;
        opacity: 0.8;
    }

    .logout-btn, .retry-btn {
        width: 100%;
        background: var(--bs-danger);
        border: none;
        border-radius: 6px;
        padding: 0.5rem;
        color: white;
        cursor: pointer;
        transition: background 0.3s ease;
    }

    .logout-btn:hover, .retry-btn:hover {
        background: #dc3545dd;
    }

    .loading, .error {
        text-align: center;
        padding: 1rem;
        font-style: italic;
    }

    .loading {
        color: var(--bs-warning);
    }

    .error {
        color: var(--bs-danger);
    }
</style>

@code {
    private List<User> users = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        UserContext.OnUserChanged += StateHasChanged;
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        isLoading = true;
        StateHasChanged();
        
        try
        {
            users = await GameApi.GetUsersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des utilisateurs: {ex.Message}");
            users = new List<User>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SelectUser(User user)
    {
        await UserContext.SelectUserAsync(user.Id);
    }

    private void Logout()
    {
        UserContext.Logout();
    }

    private bool IsCurrentUser(User user)
    {
        return UserContext.CurrentUser?.Id == user.Id;
    }

    public void Dispose()
    {
        UserContext.OnUserChanged -= StateHasChanged;
    }
}